+def _literal_call_method(script: str, start: int, end: int) -> str | None:
+    """Recognize direct HTTP calls without evaluating target JavaScript."""
+    prefix = script[max(0, start - 160):start]
+    call = re.search(r"\.\s*(get|post|put|patch|delete|head|options)\s*\(\s*(?:[\w.$]+\s*\+\s*)?$", prefix, re.I)
+    if call:
+        return call.group(1).upper()
+    if re.search(r"\bfetch\s*\(\s*$", prefix):
+        options = re.match(r"\s*,\s*\{([^{}]{0,256})\}", script[end:end + 280])
+        if options:
+            method = re.search(r"\bmethod\s*:\s*['\"]([A-Za-z]+)['\"]", options.group(1))
+            if method:
+                return method.group(1).upper()
+        return "GET"
+    return None
+
